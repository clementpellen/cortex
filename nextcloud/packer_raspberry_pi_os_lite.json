{
  "variables": {
    "RASPI_OS_VERSION": "2024-11-19",
    "RASPI_OS_CHECKSUM": "6ac3a10a1f144c7e9d1f8e568d75ca809288280a593eb6ca053e49b539f465a4",
    "RASPI_OS_IMAGE_SIZE": "3000000000"
  },
  "builders": [
    {
      "type": "arm-image",
      "iso_url": "https://downloads.raspberrypi.org/raspios_lite_arm64/images/raspios_lite_arm64-{{user `RASPI_OS_VERSION`}}/{{user `RASPI_OS_VERSION`}}-raspios-lite-arm64.zip",
      "iso_checksum": "sha256:{{user `RASPI_OS_CHECKSUM`}}",
      "target_image_size": "{{user `RASPI_OS_IMAGE_SIZE`}}"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "sudo apt-get update -y",
        "sudo apt-get full-upgrade -y",
        "sudo apt-get clean",
        "sudo apt-get install -y git ca-certificates curl docker",
        "sudo apt-get clean"
      ]
    },
    {
      "type": "file",
      "source": "install_docker_plugins.sh",
      "destination": "/usr/local/bin/install_docker_plugins.sh"
    },
    {
      "type": "shell",
      "inline": [
        "sudo chmod '0755' /usr/local/bin/install_docker_plugins.sh"
      ]
    },
    {
      "type": "file",
      "source": "docker-plugins.service",
      "destination": "/etc/systemd/system/docker-plugins.service"
    },
    {
      "type": "shell",
      "inline": [
        "sudo chmod '0644' /etc/systemd/system/docker-plugins.service",
        "sudo systemctl daemon-reload",
        "sudo systemctl enable docker-plugins.service",
        "sudo systemctl start docker-plugins.service"
      ]
    },
    {
      "type": "shell",
      "inline": [
        "sudo mkdir -p /opt/docker",
        "sudo chown -R pi:pi /opt/docker",
        "sudo chmod -R '0755' /opt/docker"
      ]
    },
    {
      "type": "file",
      "source": "../infrastructure/docker/docker-compose.arm64.yml",
      "destination": "/opt/docker/docker-compose.yml"
    },
    {
      "type": "file",
      "source": "docker-compose.service",
      "destination": "/etc/systemd/system/docker-compose.service"
    },
    {
      "type": "shell",
      "inline": [
        "sudo chmod '0644' /etc/systemd/system/docker-compose.service",
        "sudo systemctl daemon-reload",
        "sudo systemctl enable docker-compose.service",
        "sudo systemctl start docker-compose.service"
      ]
    }
  ]
}
